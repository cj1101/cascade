# Cascade Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# REQUIRED: Gemini API Key for AI image generation
# ========================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# REQUIRED: Instagram Graph API Credentials
# ========================================
# These are used for posting to Instagram via Meta Graph API
# The code maps these to INSTAGRAM_ACCESS_TOKEN and INSTAGRAM_ACCOUNT_ID

# Your Instagram Business Account access token (long-lived, ~60 days)
# Starts with "EA" - obtain via Meta Developer Portal
CASCADIA_ACCESS_TOKEN=your_instagram_access_token_here

# Your Instagram Business Account ID (numeric)
# Find via Graph API Explorer: GET /me/accounts
CASCADIA_ACCOUNT_ID=your_instagram_account_id_here

# ========================================
# OPTIONAL: Meta App Credentials
# ========================================
# Used for token refresh (if implementing automatic token renewal)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# ========================================
# OPTIONAL: Instagram App Credentials
# ========================================
# Additional app credentials if needed
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# ========================================
# OPTIONAL: SSH Key Location
# ========================================
# Path to SSH key for deployment
KEY_PAIR_LOCATION=path/to/your/key.pem

